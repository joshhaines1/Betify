        "simulator": true
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "image": "latest"
      }
    },
    "production-apk": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "apk"
      }
    }
    
  },
